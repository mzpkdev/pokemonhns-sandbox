{
  "name": "pokemonhns-devtooling",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "e2e": "pnpm run tographer:catalog && turbo run e2e",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "tographer": "pnpm run tographer:catalog && pnpm --filter @wayfarer/ui run dev",
    "tographer:catalog": "pnpm run build && pnpm exec wcartographer --catalog --output build/tographer/map-catalog",
    "cartographer": "pnpm --filter @wayfarer/cartographer run render",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@wayfarer/cartographer": "workspace:*",
    "@types/node": "24.10.1",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "webanvil": "^0.0.17"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@11.9.0"
}
