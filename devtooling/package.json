{
  "name": "pokemonhns-devtooling",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "map-render": "npm run build && npm --workspace @pokemonhns/devtooling-map-render run render --",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "webanvil": "0.0.13"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "npm@11.9.0"
}
